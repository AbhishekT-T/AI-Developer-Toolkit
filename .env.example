# Serverless AI Gateway Environment Variables
# Copy this file to .env for local testing or set in Cloudflare/Vercel/Netlify dashboard

# AI Provider: gemini, openai, anthropic, deepseek, groq, openrouter
AI_PROVIDER=gemini

# Default Server-Side AI API Key (NEVER exposed to frontend browser)
AI_API_KEY=

# Optional model override (e.g. gemini-2.0-flash, gpt-4o-mini, llama-3.3-70b-versatile)
AI_MODEL=gemini-2.0-flash

# Anonymous Daily AI Request Limit per Client IP (Enforced by server)
FREE_DAILY_AI_LIMIT=3

# AdSense Monetization Toggle (true / false)
ADS_ENABLED=false

# Optional Port for local dev server
PORT=3000
